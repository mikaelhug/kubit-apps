#!/bin/sh
status=0
for f in $(git diff --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml'); do
  [ "$f" = ".sops.yaml" ] && continue
  staged=$(git show ":$f")
  encrypted=no
  printf '%s\n' "$staged" | grep -qE '^sops:' && encrypted=yes
  if [ $encrypted = no ] && printf '%s\n' "$staged" | grep -qE '^kind:[[:space:]]*Secret[[:space:]]*$'; then
    echo "pre-commit: $f is a plaintext Secret. Encrypt it: sops encrypt -i $f" >&2
    status=1
  fi
  case "$f" in
    *.sops.yaml) [ $encrypted = no ] && { echo "pre-commit: $f is not encrypted. Run: sops encrypt -i $f" >&2; status=1; } ;;
  esac
done
exit $status
